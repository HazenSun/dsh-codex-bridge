{
  "$ref": "#/definitions/delegation_request",
  "definitions": {
    "delegation_request": {
      "type": "object",
      "properties": {
        "strategy": {
          "type": "string",
          "enum": ["auto", "single", "multi"],
          "default": "auto"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "roles": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "maxItems": 32,
          "default": []
        }
      },
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
