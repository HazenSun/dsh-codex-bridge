{
  "$ref": "#/definitions/cancel_taskOutput",
  "definitions": {
    "cancel_taskOutput": {
      "type": "object",
      "properties": {
        "protocol_version": { "type": "string", "const": "bridge.dsh.dev/v1alpha1" },
        "task_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "trace_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "status": {
          "type": "string",
          "enum": [
            "validating",
            "queued",
            "preparing_workspace",
            "running",
            "waiting_input",
            "collecting",
            "cancelling",
            "completed",
            "partial",
            "cancelled",
            "timed_out",
            "interrupted",
            "failed"
          ]
        },
        "accepted_at": { "type": "string", "format": "date-time" }
      },
      "required": ["protocol_version", "task_id", "trace_id", "status", "accepted_at"],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
