        "task_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "timeout_seconds": { "type": "integer", "minimum": 0, "maximum": 30 }
      },
      "required": ["protocol_version", "task_id", "timeout_seconds"],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
