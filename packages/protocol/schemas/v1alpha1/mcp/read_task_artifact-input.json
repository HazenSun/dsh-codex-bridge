{
  "$ref": "#/definitions/read_task_artifactInput",
  "definitions": {
    "read_task_artifactInput": {
      "type": "object",
      "properties": {
        "protocol_version": {
          "type": "string",
          "const": "bridge.dsh.dev/v1alpha1"
        },
        "task_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "artifact_id": {
          "$ref": "#/definitions/read_task_artifactInput/properties/task_id"
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        },
        "limit": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 1048576
        },
        "expected_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": ["protocol_version", "task_id", "artifact_id", "offset", "limit"],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
