{
  "$ref": "#/definitions/artifact_ref",
  "definitions": {
    "artifact_ref": {
      "type": "object",
      "properties": {
        "artifact_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "task_id": {
          "$ref": "#/definitions/artifact_ref/properties/artifact_id"
        },
        "kind": {
          "type": "string",
          "enum": [
            "patch",
            "diff_stat",
            "changed_files",
            "test_report",
            "command_log",
            "agent_log",
            "summary",
            "other"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "media_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9!#$%&'*+.^_`|~-]*\\/[A-Za-z0-9][A-Za-z0-9!#$%&'*+.^_`|~-]*(?:;.*)?$"
        },
        "encoding": {
          "type": "string",
          "enum": ["utf8", "base64"]
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "uri": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "artifact_id",
        "task_id",
        "kind",
        "name",
        "media_type",
        "encoding",
        "bytes",
        "sha256",
        "uri",
        "created_at"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
