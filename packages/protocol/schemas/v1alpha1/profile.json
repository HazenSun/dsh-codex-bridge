{
  "$ref": "#/definitions/profile",
  "definitions": {
    "profile": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100000
        },
        "dsh": {
          "type": "object",
          "properties": {
            "provider": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
            },
            "model": {
              "$ref": "#/definitions/profile/properties/dsh/properties/provider"
            },
            "reasoning_effort": {
              "$ref": "#/definitions/profile/properties/dsh/properties/provider"
            },
            "agent_preset": {
              "$ref": "#/definitions/profile/properties/dsh/properties/provider"
            },
            "max_tokens": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 1000000
            }
          },
          "required": ["provider", "model", "agent_preset", "max_tokens"],
          "additionalProperties": false
        },
        "delegation": {
          "type": "object",
          "properties": {
            "max_depth": {
              "type": "integer",
              "minimum": 0,
              "maximum": 32,
              "default": 0
            },
            "max_children": {
              "type": "integer",
              "minimum": 0,
              "maximum": 128,
              "default": 0
            },
            "roles": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "provider": {
                    "$ref": "#/definitions/profile/properties/dsh/properties/provider"
                  },
                  "model": {
                    "$ref": "#/definitions/profile/properties/dsh/properties/provider"
                  },
                  "reasoning_effort": {
                    "$ref": "#/definitions/profile/properties/dsh/properties/provider"
                  },
                  "max_tokens": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 1000000
                  },
                  "description": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  }
                },
                "required": ["provider", "model"],
                "additionalProperties": false
              },
              "propertyNames": {
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
              },
              "default": {}
            }
          },
          "additionalProperties": false
        },
        "workspace": {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "enum": ["isolated_worktree", "patch_only"]
            },
            "allowed_roots": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/profile/properties/delegation/properties/roles/additionalProperties/properties/description"
              },
              "maxItems": 64,
              "default": []
            }
          },
          "required": ["mode"],
          "additionalProperties": false
        },
        "policy": {
          "type": "object",
          "properties": {
            "network": {
              "type": "string",
              "enum": ["off", "restricted", "full"]
            },
            "allowed_domains": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/profile/properties/delegation/properties/roles/additionalProperties/properties/description"
              },
              "maxItems": 256,
              "default": []
            },
            "denied_paths": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/profile/properties/delegation/properties/roles/additionalProperties/properties/description"
              },
              "maxItems": 256,
              "default": []
            },
            "timeout_seconds": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 86400,
              "default": 1800
            },
            "max_artifact_bytes": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 1073741824,
              "default": 10485760
            },
            "max_output_bytes": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 1073741824,
              "default": 10485760
            },
            "max_files": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 100000,
              "default": 10000
            },
            "disk_quota_bytes": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 1099511627776,
              "default": 1073741824
            }
          },
          "required": ["network"],
          "additionalProperties": false
        },
        "capabilities": {
          "type": "object",
          "properties": {
            "supports_followup": {
              "type": "boolean"
            },
            "supports_cancel": {
              "type": "boolean"
            },
            "supports_subagents": {
              "type": "boolean"
            },
            "supported_workspace_modes": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/profile/properties/workspace/properties/mode"
              },
              "minItems": 1,
              "maxItems": 2
            }
          },
          "required": [
            "supports_followup",
            "supports_cancel",
            "supports_subagents",
            "supported_workspace_modes"
          ],
          "additionalProperties": false
        },
        "metadata": {
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/profile/properties/metadata/additionalProperties"
                }
              },
              {
                "type": "object",
                "additionalProperties": {
                  "$ref": "#/definitions/profile/properties/metadata/additionalProperties"
                }
              }
            ]
          }
        },
        "protocol_version": {
          "type": "string",
          "const": "bridge.dsh.dev/v1alpha1"
        },
        "profile_id": {
          "$ref": "#/definitions/profile/properties/dsh/properties/provider"
        }
      },
      "required": [
        "description",
        "dsh",
        "delegation",
        "workspace",
        "policy",
        "protocol_version",
        "profile_id"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
