{
  "name": "@dsh-codex-bridge/task-engine",
  "version": "0.1.0-alpha.2",
  "description": "Recoverable asynchronous task orchestration for DSH Codex Bridge.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HazenSun/dsh-codex-bridge.git",
    "directory": "packages/task-engine"
  },
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --sourcemap",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@dsh-codex-bridge/config": "workspace:*",
    "@dsh-codex-bridge/dsh-runtime": "workspace:*",
    "@dsh-codex-bridge/protocol": "workspace:*",
    "@dsh-codex-bridge/workspace": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "tsup": "^8.5.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
