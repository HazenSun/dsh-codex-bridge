{
  "name": "@dsh-codex-bridge/mcp-server",
  "version": "0.1.0-alpha.2",
  "description": "STDIO MCP gateway exposing DSH Codex Bridge task tools.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HazenSun/dsh-codex-bridge.git",
    "directory": "packages/mcp-server"
  },
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --sourcemap",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@dsh-codex-bridge/protocol": "workspace:*",
    "@dsh-codex-bridge/task-engine": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsup": "^8.5.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
